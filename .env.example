# ==============================================================================
# Ethio-Pay Production Environment Configuration
# Copy this file to `.env` and fill in your live or staging credentials.
# Leave BASE_URL variables unset in production to use official gateway endpoints.
# ==============================================================================

NODE_ENV=production
PORT=3000

# --- Chapa ---
CHAPA_SECRET_KEY=CHASECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_HASH=your_chapa_webhook_secret_hash

# --- Telebirr (Fabric H5 / RSA-2048) ---
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
TELEBIRR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- CBE Birr ---
CBEBIRR_TILL_CODE=your_till_code
CBEBIRR_API_KEY=your_cbebirr_api_key
CBEBIRR_SECRET_HASH=your_cbebirr_webhook_secret

# --- ArifPay ---
ARIFPAY_API_KEY=your_arifpay_api_key
ARIFPAY_SECRET_KEY=your_arifpay_secret_key

# --- SantimPay ---
SANTIMPAY_MERCHANT_ID=your_santimpay_merchant_id
SANTIMPAY_AUTH_TOKEN=your_santimpay_auth_token
SANTIMPAY_CLIENT_SECRET=your_santimpay_client_secret

# --- Awash Birr ---
AWASHBIRR_MERCHANT_ID=your_awashbirr_merchant_id
AWASHBIRR_PASS_KEY=your_awashbirr_pass_key
AWASHBIRR_SECRET_HASH=your_awashbirr_secret_hash

# --- Unified SMS & OTP Gateways (@ethio-pay/sms) ---
AFROMESSAGE_TOKEN=your_afromessage_api_token
AFROMESSAGE_SENDER_ID=EthioPay
GEEZSMS_TOKEN=your_geezsms_token
ETHIOTELECOM_SMS_USER=your_ethiotelecom_username
ETHIOTELECOM_SMS_PASS=your_ethiotelecom_password

# --- Persistent Idempotency Store (Recommended for Production) ---
REDIS_URL=redis://localhost:6379

