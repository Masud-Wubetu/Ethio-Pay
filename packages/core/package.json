{
  "name": "@ethio-pay/core",
  "version": "0.1.0-beta.0",
  "description": "Core interfaces, provider contracts, HTTP client, HMAC webhook verification, and idempotency middleware for Ethio-Pay SDK",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Masud-Wubetu/Ethio-Pay.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ethio-pay",
    "ethiopia",
    "payment",
    "sdk",
    "chapa",
    "telebirr",
    "cbe-birr",
    "webhooks",
    "hmac",
    "idempotency"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

